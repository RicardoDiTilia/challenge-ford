{
  "expo": {
    "name": "Ford Vision",
    "slug": "ford-vision",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fordvision",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fordvision.app"
    },
    "android": {
      "package": "com.fordvision.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
